[Unit]
Description=Manutencao automatica do banco XUI NAXX
After=network-online.target mariadb.service xuione.service
Wants=network-online.target xuione.service
Requires=mariadb.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/xui
ExecStart=/usr/bin/python3 /usr/local/sbin/naxx-atualizar-banco
TimeoutStartSec=180
UMask=0077
Nice=10

[Install]
WantedBy=multi-user.target
